<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AkisGestureApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AkisGesture">

        <service
            android:name=".service.GestureAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled edge gesture navigation service available." />
        </service>

        <service
            android:name=".service.GestureTileService"
            android:exported="true"
            android:icon="@drawable/ic_gesture_24"
            android:label="Akış hareketleri"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.GestureCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.omer.akisgesture.action.START" />
                <action android:name="com.omer.akisgesture.action.STOP" />
                <action android:name="com.omer.akisgesture.action.TOGGLE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".service.StartGestureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Akış · Hareketleri başlat"
            android:noHistory="true"
            android:theme="@style/Theme.AkisGesture" />
        <activity
            android:name=".service.StopGestureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Akış · Hareketleri durdur"
            android:noHistory="true"
            android:theme="@style/Theme.AkisGesture" />
        <activity
            android:name=".service.ToggleGestureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Akış · Durumu değiştir"
            android:noHistory="true"
            android:theme="@style/Theme.AkisGesture" />

        <activity
            android:name=".service.MacroDroidPluginActivity"
            android:exported="true"
            android:label="Akış Gesture">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".service.MacroDroidPluginReceiver"
            android:exported="true"
            android:label="Akış Gesture">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AkisGesture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
