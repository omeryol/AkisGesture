    <string name="tab_motion">እንቅስቃሴ</string><string name="tab_appearance">ገጽታ</string><string name="tab_pause">አቁም</string><string name="tab_backup">ምትኬ</string><string name="tab_about">ስለ</string><string name="tab_root">Root</string><string name="motion_section">የጠርዝና የእንቅስቃሴ ፊዚክስ</string><string name="motion_section_subtitle">የማስነሻ አካባቢዎች፣ ስሜታዊነትና የመያዣ ቅንብሮች</string><string name="trigger_thickness">የማስነሻ ውፍረት</string><string name="trigger_help">ማስነሻ፦ በጠርዙ ላይ ያለው የንክኪ አካባቢ ውፍረት።</string><string name="sensitivity_damping">ስሜታዊነት (ዳምፒንግ)</string><string name="sensitivity_help">ስሜታዊነት፦ የመጎተት መቋቋም። ዝቅተኛ ዳምፒንግ ፈጣን ምላሽ ይሰጣል፤ ከፍተኛው የበለጠ መጎተት ይፈልጋል።</string><string name="threshold_distance">የገደብ ርቀት</string><string name="threshold_help">ገደብ፦ ፈጣን ማንሸራተትን ለማስነሳት የሚያስፈልገው አነስተኛ ርቀት።</string><string name="l_threshold">የL-ማንሸራተት መታጠፊያ ገደብ</string><string name="l_threshold_help">የL ገደብ፦ L እንቅስቃሴን ለመለየት የሚያስፈልገው ቁመታዊ መታጠፊያ። ቁመታዊው ማንሸራተት ከአግድም ማንሸራተት ጋር ቢያንስ እኩል መሆን አለበት።</string><string name="hold_duration">የማንሸራተትና የመያዝ ጊዜ</string><string name="hold_mode">የመያዣ ማንቂያ ሁነታ</string>
