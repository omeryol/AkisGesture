    <string name="pause_warning_landscape_title">የአግድም ሁነታ ማቆም ንቁ ነው</string><string name="pause_warning_lock_title">የመቆለፊያ ስክሪን ማቆም ንቁ ነው</string><string name="pause_warning_lock_desc">መሣሪያው በተቆለፈ ጊዜ Akış እንቅስቃሴዎች አይገኙም።</string><string name="pause_warning_landscape_desc">ስክሪኑ በአግድም አቅጣጫ ሲሆን Akış እንቅስቃሴዎች አይገኙም።</string><string name="pause_warning_fullscreen_title">የሙሉ ስክሪን ማቆም ንቁ ነው</string><string name="pause_warning_fullscreen_desc">በሙሉ ስክሪን መተግበሪያዎች ላይ Akış እንቅስቃሴዎች አይገኙም። ለመውጣት የስርዓት አሰሳን ወይም መተግበሪያውን ይጠቀሙ።</string><string name="pause_warning_permission_title">በፍቃድ ስክሪን ላይ ማቆም ንቁ ነው</string><string name="pause_warning_permission_desc">የAndroid ፍቃድ ወይም APK መጫኛ ስክሪኖች ክፍት ሲሆኑ Akış እንቅስቃሴዎች አይገኙም።</string><string name="pause_warning_camera_title">የካሜራ ማቆም ንቁ ነው</string><string name="pause_warning_camera_desc">ካሜራው ወይም የቪዲዮ ቀረጻ ንቁ ሲሆን Akış እንቅስቃሴዎች ይቆማሉ።</string><string name="pause_warning_call_title">የጥሪ ማቆም ንቁ ነው</string><string name="pause_warning_call_desc">በሚገቡ ወይም በሚካሄዱ ጥሪዎች ጊዜ Akış እንቅስቃሴዎች ይቆማሉ።</string><string name="pause_warning_launcher_title">የላንቸር ማቆም ንቁ ነው</string><string name="pause_warning_launcher_desc">በመነሻ ስክሪን ላይ Akış እንቅስቃሴዎች ይቆማሉ።</string><string name="keyboard_open_warning_title">⚠️ የቁልፍ ሰሌዳ ማቆም ሁሉንም የAkış ጠርዝ እንቅስቃሴዎች ያሰናክላል</string><string name="keyboard_open_warning_desc">ሲነቃ ቁልፍ ሰሌዳው ሲታይ Akış የእንቅስቃሴ መደራረቢያዎቹን ያስወግዳል። ለመውጣት ቁልፍ ሰሌዳውን ወይም የስርዓት አሰሳን ይጠቀሙ፤ ቁልፍ ሰሌዳው ሲዘጋ እንቅስቃሴዎቹ በራስ-ሰር ይመለሳሉ።</string>
